POSTGRES_DB=worksphere
POSTGRES_USER=worksphere
POSTGRES_PASSWORD=replace-with-a-strong-unique-password
DATABASE_URL=postgresql+asyncpg://worksphere:replace-with-a-strong-unique-password@localhost:5432/worksphere
REDIS_URL=redis://localhost:6379/0
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-unique-64-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_PORT=8000
FRONTEND_PORT=3000
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_HOSTS=*
